.page{min-height:100vh;background:#f5f8ff;padding:34rpx;box-sizing:border-box}.cover{background:linear-gradient(145deg,#177fd9,#63bff1);border-radius:46rpx;padding:48rpx 38rpx;color:#fff;box-shadow:0 18rpx 32rpx rgba(32,113,184,.22)}.cover text{font-size:18rpx;letter-spacing:4rpx;opacity:.75}.cover b{font-size:55rpx;line-height:1.25;display:block;margin:22rpx 0}.cover view{font-size:23rpx;opacity:.9}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:28rpx}.metrics view{background:#fff;border-radius:28rpx;padding:27rpx 22rpx;box-shadow:0 7rpx 18rpx rgba(44,111,166,.08)}.metrics text{display:block;font-size:21rpx;color:#7994ac}.metrics b{display:block;margin-top:11rpx;font-size:30rpx;color:#24567f}.note{background:#fff5da;padding:30rpx;border-radius:29rpx;margin-top:26rpx;color:#765f40}.note text{display:block;font-size:21rpx}.note b{display:block;font-size:34rpx;margin:14rpx 0}.note view{font-size:21rpx;line-height:1.7}.privacy{margin-top:24rpx;padding:25rpx 28rpx;border-radius:26rpx;background:#edf8ff;color:#336d9e}.privacy b{display:block;font-size:26rpx}.privacy text{display:block;font-size:21rpx;line-height:1.65;margin-top:8rpx}.page button{margin-top:30rpx;background:#1685e4;color:#fff;border-radius:24rpx}
