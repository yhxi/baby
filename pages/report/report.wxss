.page{min-height:100vh;background:#fbf7ff;padding:34rpx;box-sizing:border-box}.cover{background:linear-gradient(145deg,#7763c7,#b990e0);border-radius:46rpx;padding:48rpx 38rpx;color:#fff;box-shadow:0 18rpx 32rpx rgba(101,78,170,.22)}.cover text{font-size:18rpx;letter-spacing:4rpx;opacity:.75}.cover b{font-size:55rpx;line-height:1.25;display:block;margin:22rpx 0}.cover view{font-size:23rpx;opacity:.9}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:28rpx}.metrics view{background:#fff;border-radius:28rpx;padding:27rpx 22rpx;box-shadow:0 7rpx 18rpx rgba(113,88,154,.08)}.metrics text{display:block;font-size:21rpx;color:#94869d}.metrics b{display:block;margin-top:11rpx;font-size:30rpx;color:#594770}.note{background:#fff2d4;padding:30rpx;border-radius:29rpx;margin-top:26rpx;color:#765f40}.note text{display:block;font-size:21rpx}.note b{display:block;font-size:34rpx;margin:14rpx 0}.note view{font-size:21rpx;line-height:1.7}.page button{margin-top:30rpx;background:#765dc5;color:#fff;border-radius:24rpx}
