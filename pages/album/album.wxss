.page{min-height:100vh;background:#fff6f8;padding-bottom:180rpx}.mast{position:relative;overflow:hidden;padding:62rpx 38rpx 55rpx;color:#fff;background:linear-gradient(135deg,#ff98bc,#c899df);border-radius:0 0 56rpx 56rpx}.mast:after{content:'';position:absolute;width:300rpx;height:300rpx;right:-120rpx;bottom:-190rpx;border:28rpx solid rgba(255,255,255,.14);border-radius:50%}.eyebrow{font-size:18rpx;letter-spacing:4rpx;opacity:.72}.title{font-weight:800;font-size:58rpx;margin-top:8rpx}.sub{font-size:23rpx;margin-top:10rpx;opacity:.94}.bubble{position:absolute;opacity:.8}.b1{right:76rpx;top:46rpx;color:#ffe763;font-size:36rpx}.b2{right:32rpx;top:93rpx;font-size:25rpx}.tabs{display:flex;gap:14rpx;padding:26rpx 30rpx 14rpx}.tab{padding:13rpx 26rpx;border-radius:30rpx;background:#fff;color:#ad8494;font-size:24rpx}.tab.active{background:#ef70a5;color:#fff;box-shadow:0 7rpx 16rpx rgba(231,84,145,.27)}.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;padding:12rpx 30rpx}.photo-tile{height:206rpx;overflow:hidden;position:relative;border-radius:20rpx;background:#f2e7ed;box-shadow:0 6rpx 14rpx rgba(165,103,130,.12)}.photo-tile image{width:100%;height:100%}.photo-date,.loading{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(transparent,rgba(46,28,39,.68));padding:24rpx 10rpx 9rpx;color:#fff;font-size:18rpx}.loading{top:0;bottom:auto;padding:8rpx;background:rgba(45,26,40,.45);text-align:center}.cloud-photo{height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;font-size:42rpx;color:#a58b9a}.cloud-photo text{font-size:19rpx;margin-top:8rpx}.empty{display:flex;align-items:center;flex-direction:column;padding:150rpx 0 90rpx;color:#9c8190}.empty view{font-size:88rpx}.empty b{font-size:34rpx;margin-top:20rpx;color:#5a4452}.empty text{font-size:23rpx;margin-top:12rpx}.tip{text-align:center;color:#bb9ca9;font-size:20rpx;padding:34rpx}.upload{position:fixed;right:36rpx;bottom:48rpx;width:126rpx;height:126rpx;border-radius:44rpx;background:linear-gradient(145deg,#ff8ab7,#ef5d9a);box-shadow:0 16rpx 30rpx rgba(234,76,141,.35);color:#fff;display:flex;align-items:center;justify-content:center;flex-direction:column}.upload text{font-size:52rpx;line-height:47rpx}.upload small{font-size:18rpx}

.page{background:#061238}.mast{background:linear-gradient(135deg,#314ca9,#151f6b);border:1rpx solid rgba(157,188,255,.35)}.tab{background:rgba(52,78,153,.6);border:1rpx solid rgba(163,192,255,.25);color:#bdccec}.tab.active{background:#6178e8;box-shadow:0 7rpx 18rpx rgba(96,123,255,.4)}.photo-tile{background:#1a316e;border:1rpx solid rgba(159,190,255,.28);box-shadow:0 8rpx 18rpx rgba(0,0,28,.35)}.cloud-photo,.empty,.tip{color:#aebfe2}.empty b{color:#f4f7ff}.upload{background:linear-gradient(145deg,#82b7ff,#5366dd);box-shadow:0 16rpx 30rpx rgba(65,87,221,.42)}
