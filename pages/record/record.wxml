<view class="page">
  <!-- 类型选择 -->
  <view class="card">
    <view class="section-title">记录类型</view>
    <view class="type-grid">
      <view class="type-item {{item.key === type ? 'active' : ''}}" wx:for="{{types}}" wx:key="key" data-type="{{item.key}}" bindtap="onTypeChange">
        <view class="type-icon">{{item.icon}}</view>
        <view class="type-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 时间与日期 -->
  <view class="card">
    <view class="form-row">
      <text class="form-label">日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="form-value">{{date}} <text class="arrow">›</text></view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">时间</text>
      <picker mode="time" value="{{time}}" bindchange="onTimeChange">
        <view class="form-value">{{time}} <text class="arrow">›</text></view>
      </picker>
    </view>
  </view>

  <!-- 类型相关字段 -->
  <view class="card" wx:if="{{type === 'feed' || type === 'pump' || type === 'medicine'}}">
    <view class="form-row">
      <text class="form-label">{{type === 'medicine' ? '剂量' : '奶量'}}</text>
      <input class="form-input" type="digit" placeholder="0" value="{{amount}}" bindinput="onAmountInput" />
      <text class="form-unit">ml</text>
    </view>
    <view class="form-row" wx:if="{{type === 'medicine'}}">
      <text class="form-label">名称</text>
      <input class="form-input" placeholder="如：维生素D" value="{{medicineName}}" bindinput="onMedicineInput" />
    </view>
  </view>

  <view class="card" wx:if="{{type === 'breast' || type === 'sleep'}}">
    <view class="form-row">
      <text class="form-label">时长</text>
      <input class="form-input" type="digit" placeholder="0" value="{{durationMinutes}}" bindinput="onDurationInput" />
      <text class="form-unit">{{type === 'sleep' ? '分钟' : '分钟'}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{type === 'diaper'}}">
    <view class="section-title">尿布类型</view>
    <view class="seg">
      <view class="seg-item {{diaperType === 'pee' ? 'active' : ''}}" data-value="pee" bindtap="onDiaperChange">小便</view>
      <view class="seg-item {{diaperType === 'poop' ? 'active' : ''}}" data-value="poop" bindtap="onDiaperChange">大便</view>
      <view class="seg-item {{diaperType === 'both' ? 'active' : ''}}" data-value="both" bindtap="onDiaperChange">大小便</view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="card">
    <view class="form-row col">
      <text class="form-label">备注</text>
      <textarea class="form-textarea" placeholder="可选，记录一些细节…" value="{{note}}" bindinput="onNoteInput" maxlength="200" />
    </view>
  </view>

  <view class="btn-row">
    <button class="btn-save" bindtap="onSave">保存记录</button>
    <button wx:if="{{isEdit}}" class="btn-delete" bindtap="onDelete">删除</button>
  </view>
</view>
