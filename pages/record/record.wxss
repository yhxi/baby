.page {
  min-height: 100vh;
  padding: 24rpx 30rpx 60rpx;
}

.card {
  margin-bottom: 24rpx;
}

/* 类型选择 */
.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 20rpx;
}

.type-item {
  width: calc((100% - 54rpx) / 4);
  border: 2rpx solid #f0e6e2;
  border-radius: 18rpx;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
}

.type-item.active {
  border-color: #FF7B7B;
  background: #FFF0F0;
}

.type-icon {
  font-size: 44rpx;
}

.type-label {
  font-size: 24rpx;
  color: #555;
  margin-top: 8rpx;
}

/* 表单 */
.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5eeea;
}

.form-row:last-child {
  border-bottom: none;
}

.form-row.col {
  flex-direction: column;
  align-items: stretch;
}

.form-label {
  width: 150rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.form-value {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  text-align: right;
}

.arrow {
  color: #ccc;
  margin-left: 8rpx;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
}

.form-unit {
  font-size: 26rpx;
  color: #999;
  margin-left: 12rpx;
  width: 70rpx;
  text-align: right;
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  font-size: 28rpx;
  color: #333;
  margin-top: 14rpx;
  line-height: 1.5;
}

/* 分段控件 */
.seg {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: #f7f1ee;
  color: #666;
  font-size: 28rpx;
}

.seg-item.active {
  background: #FF7B7B;
  color: #fff;
}

/* 按钮 */
.btn-row {
  margin-top: 30rpx;
  display: flex;
  gap: 20rpx;
}

.btn-save {
  flex: 1;
  background: linear-gradient(135deg, #FF7B7B 0%, #FF9EB5 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
}

.btn-delete {
  width: 200rpx;
  background: #fff;
  color: #FF7B7B;
  font-size: 30rpx;
  border-radius: 50rpx;
  border: 2rpx solid #FF7B7B;
}

button::after {
  border: none;
}
