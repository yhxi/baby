.page {
  min-height: 100vh;
  padding: 24rpx 30rpx 60rpx;
}

.card {
  margin-bottom: 24rpx;
}

/* 类型选择 */
.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 20rpx;
}

.type-item {
  width: calc((100% - 54rpx) / 4);
  border: 2rpx solid var(--border);
  border-radius: 18rpx;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--card);
}

.type-item.active {
  border-color: #167FDB;
  background: #E6F4FF;
}

.type-icon {
  font-size: 44rpx;
}

.type-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 表单 */
.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.form-row:last-child {
  border-bottom: none;
}

.form-row.col {
  flex-direction: column;
  align-items: stretch;
}

.form-label {
  width: 150rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.form-value {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  text-align: right;
}

.arrow {
  color: var(--text-tertiary);
  margin-left: 8rpx;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
}

.form-unit {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-left: 12rpx;
  width: 70rpx;
  text-align: right;
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-top: 14rpx;
  line-height: 1.5;
}

/* 分段控件 */
.seg {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: var(--surface-2);
  color: var(--text-secondary);
  font-size: 28rpx;
}

.seg-item.active {
  background: #167FDB;
  color: #fff;
}

/* 按钮 */
.btn-row {
  margin-top: 30rpx;
  display: flex;
  gap: 20rpx;
}

.btn-save {
  flex: 1;
  background: linear-gradient(135deg, #31B5FF 0%, #167FDB 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
}

.btn-delete {
  width: 200rpx;
  background: var(--card);
  color: #167FDB;
  font-size: 30rpx;
  border-radius: 50rpx;
  border: 2rpx solid #167FDB;
}

button::after {
  border: none;
}

.amount-section { padding-top: 22rpx; }
.amount-caption { color: var(--text-secondary); font-size: 23rpx; }
.amount-caption text { float: right; color: #167FDB; font-weight: 600; }
.amount-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.amount-chip { width: calc((100% - 42rpx) / 4); box-sizing: border-box; padding: 16rpx 0; border-radius: 16rpx; background: #F2FAFF; border: 2rpx solid #D6ECFB; color: #427EA9; text-align: center; font-size: 27rpx; font-weight: 600; }
.amount-chip small { margin-left: 3rpx; font-size: 17rpx; font-weight: 400; }
.amount-chip.active { background: #167FDB; border-color: #167FDB; color: #fff; box-shadow: 0 6rpx 14rpx rgba(22,127,219,.24); }
