<view class="page {{appDark ? 'dark' : ''}}">
  <!-- 今日概览 -->
  <view class="section-title">今日概览</view>
  <view class="stat-grid">
    <view class="stat-card" style="background:var(--primary-light);">
      <view class="stat-icon">🍼</view>
      <view class="stat-value">{{stats.feedAmount}}<text class="stat-unit">ml</text></view>
      <view class="stat-label">喂奶总量</view>
    </view>
    <view class="stat-card" style="background:var(--pump-light);">
      <view class="stat-icon">🤱</view>
      <view class="stat-value">{{stats.breastMinutes}}<text class="stat-unit">分</text></view>
      <view class="stat-label">亲喂时长</view>
    </view>
    <view class="stat-card" style="background:var(--sleep-light);">
      <view class="stat-icon">😴</view>
      <view class="stat-value">{{stats.sleepMinutes}}<text class="stat-unit">分</text></view>
      <view class="stat-label">睡眠时长</view>
    </view>
    <view class="stat-card" style="background:var(--diaper-light);">
      <view class="stat-icon">👶</view>
      <view class="stat-value">{{stats.diaperCount}}<text class="stat-unit">次</text></view>
      <view class="stat-label">换尿布</view>
    </view>
  </view>

  <!-- 次数统计 -->
  <view class="card">
    <view class="section-title">今日次数</view>
    <view class="count-row">
      <view class="count-item">
        <text class="count-num">{{stats.feedCount}}</text>
        <text class="count-label">喂奶</text>
      </view>
      <view class="count-item">
        <text class="count-num">{{stats.breastCount}}</text>
        <text class="count-label">亲喂</text>
      </view>
      <view class="count-item">
        <text class="count-num">{{stats.medicineCount}}</text>
        <text class="count-label">补剂</text>
      </view>
    </view>
  </view>

  <!-- 重要日子倒计时 -->
  <view class="card">
    <view class="section-title">重要日子倒计时</view>
    <view class="anni-row" wx:for="{{anniversary}}" wx:key="name">
      <view class="anni-name">{{item.name}}</view>
      <view class="anni-bar">
        <view class="anni-fill {{item.passed ? 'passed' : ''}}" style="width:{{item.percent}}%;"></view>
      </view>
      <view class="anni-text {{item.passed ? 'passed' : ''}}">{{item.text}}</view>
    </view>
    <view wx:if="{{anniversary.length === 0}}" class="anni-tip">在「家庭」设置宝宝出生日期后显示</view>
  </view>

  <!-- 今日分析 -->
  <view class="card">
    <view class="section-title">今日分析</view>
    <view class="count-row">
      <view class="count-item">
        <text class="count-num">{{feedAvgInterval}}<text class="count-sub">分</text></text>
        <text class="count-label">平均喂奶间隔</text>
      </view>
      <view class="count-item">
        <text class="count-num">{{longestSleep}}<text class="count-sub">分</text></text>
        <text class="count-label">最长单次睡眠</text>
      </view>
    </view>
  </view>

  <view class="card care-card">
    <view class="section-title">照护小提示</view>
    <view wx:for="{{careHints}}" wx:key="title" class="hint-row">
      <text class="hint-icon">{{item.icon}}</text><view><b>{{item.title}}</b><text>{{item.text}}</text></view>
    </view>
  </view>

  <view class="safety-card">
    <b>需要尽快就医的情况</b>
    <text>如新生儿出现发热、呼吸费力或发青、明显嗜睡难唤醒、持续拒奶，或你直觉感到不对劲，请及时联系儿科或急救服务。</text>
    <small>本页只整理记录，不替代医生诊断或医嘱。</small>
  </view>

  <!-- 近7天睡眠趋势 -->
  <view class="card">
    <view class="section-title">近 7 天睡眠趋势</view>
    <view class="chart">
      <view class="bar-wrap" wx:for="{{weekBars}}" wx:key="day">
        <view class="bar" style="height:{{item.height}}%;"></view>
        <view class="bar-min">{{item.minutes}}</view>
        <view class="bar-day">{{item.day}}</view>
      </view>
    </view>
  </view>

  <view style="height: 30rpx;"></view>
</view>
