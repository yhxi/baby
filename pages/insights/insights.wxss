.page {
  min-height: 100vh;
  padding: 30rpx 30rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin: 10rpx 0 20rpx;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.stat-card {
  width: calc((100% - 20rpx) / 2);
  border-radius: 22rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.stat-icon {
  font-size: 44rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 10rpx;
}

.stat-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-tertiary);
  margin-left: 6rpx;
}

.stat-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.card {
  margin-bottom: 28rpx;
}

.count-row {
  display: flex;
  justify-content: space-around;
  padding: 10rpx 0;
}

.count-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.count-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF7B7B;
}

.count-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

/* 图表 */
.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 320rpx;
  padding-top: 20rpx;
}

.bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
}

.bar {
  width: 36rpx;
  background: linear-gradient(180deg, #FF9EB5 0%, #FF7B7B 100%);
  border-radius: 10rpx 10rpx 0 0;
  min-height: 4rpx;
  transition: height 0.3s;
}

.bar-min {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

.bar-day {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.count-sub {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-left: 4rpx;
}

.anni-row {
  display: flex;
  align-items: center;
  margin: 18rpx 0;
}

.anni-name {
  width: 90rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.anni-bar {
  flex: 1;
  height: 16rpx;
  background: #FFF0F0;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 18rpx;
}

.anni-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF9EB5 0%, #FF7B7B 100%);
  border-radius: 8rpx;
}

.anni-fill.passed {
  background: #FFB347;
}

.anni-text {
  width: 180rpx;
  text-align: right;
  font-size: 24rpx;
  color: #FF7B7B;
}

.anni-text.passed {
  color: #FFB347;
}

.anni-tip {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
  padding: 10rpx 0;
}
