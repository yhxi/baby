.page{min-height:100vh;background:#fff7f2}.hero{padding:62rpx 38rpx 52rpx;background:linear-gradient(135deg,#ffb56e,#ff7fa8);color:#fff;border-radius:0 0 52rpx 52rpx}.hero text{display:block;font-size:25rpx}.hero b{display:block;font-size:50rpx;margin-top:12rpx}.list{margin:30rpx}.item{height:104rpx;background:#fff;border-radius:24rpx;margin-bottom:16rpx;display:flex;align-items:center;padding:0 24rpx;box-shadow:0 8rpx 22rpx rgba(194,119,88,.1)}.time{width:86rpx;color:#f07b9e;font-weight:800;font-size:27rpx}.check{width:36rpx;height:36rpx;border:3rpx solid #f5a8bf;border-radius:50%;color:#fff;background:#f47aa4;text-align:center;line-height:34rpx;margin-right:18rpx}.title{font-size:28rpx;font-weight:700;flex:1}.more{font-size:40rpx;color:#cab8bd}.done .title{text-decoration:line-through;color:#bcaeb2}.empty{text-align:center;padding:180rpx 0;color:#9c7e86;font-size:29rpx}.empty text{font-size:22rpx;color:#c5abb1}.add{position:fixed;bottom:60rpx;right:42rpx;width:112rpx;height:112rpx;border-radius:40rpx;background:#f3699c;color:white;font-size:60rpx;display:flex;align-items:center;justify-content:center}.mask{position:fixed;inset:0;background:rgba(50,29,35,.4);display:flex;align-items:flex-end}.sheet{background:#fff;width:100%;border-radius:40rpx 40rpx 0 0;padding:42rpx;box-sizing:border-box}.sheet b{font-size:35rpx}.sheet input,.clock{margin-top:26rpx;padding:20rpx;border-radius:18rpx;background:#fff4f6}.sheet button{margin-top:22rpx;background:#f3699c;color:#fff;border-radius:22rpx}
