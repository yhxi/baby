.page{min-height:100vh;background:#eaf7ff}.hero{padding:62rpx 38rpx 46rpx;background:linear-gradient(135deg,#42b8ff,#147dde);color:#fff;border-radius:0 0 52rpx 52rpx}.hero text{display:block;font-size:25rpx}.hero b{display:block;font-size:50rpx;margin-top:12rpx}.hero small{display:block;margin-top:12rpx;font-size:19rpx;opacity:.82}.preset-wrap{margin:26rpx 30rpx 4rpx}.preset-wrap>text{display:block;color:#347ab4;font-size:25rpx;font-weight:800;margin-bottom:14rpx}.presets{display:flex;gap:12rpx;overflow:hidden}.preset{flex:1;min-width:0;background:#fff;border-radius:20rpx;padding:16rpx 6rpx;text-align:center;box-shadow:0 6rpx 15rpx rgba(31,120,185,.09)}.preset text,.preset b,.preset small{display:block}.preset text{font-size:30rpx}.preset b{margin-top:5rpx;color:#245d92;font-size:19rpx;white-space:nowrap}.preset small{color:#7ba4c1;font-size:17rpx}.list{margin:24rpx 30rpx}.item{height:104rpx;background:#fff;border-radius:24rpx;margin-bottom:16rpx;display:flex;align-items:center;padding:0 24rpx;box-shadow:0 8rpx 22rpx rgba(31,120,185,.1)}.time{width:86rpx;color:#1683dc;font-weight:800;font-size:27rpx}.check{width:36rpx;height:36rpx;border:3rpx solid #9acdf0;border-radius:50%;color:#fff;background:#248be0;text-align:center;line-height:34rpx;margin-right:18rpx}.title{font-size:28rpx;font-weight:700;flex:1;color:#245481}.more{font-size:40rpx;color:#a9c9df}.done .title{text-decoration:line-through;color:#9badba}.empty{text-align:center;padding:160rpx 0;color:#5e8eb1;font-size:29rpx}.empty text{font-size:22rpx;color:#8aafc8}.add{position:fixed;bottom:60rpx;right:42rpx;width:112rpx;height:112rpx;border-radius:40rpx;background:#1685e4;color:white;font-size:60rpx;display:flex;align-items:center;justify-content:center;box-shadow:0 10rpx 20rpx rgba(16,111,203,.3)}.mask{position:fixed;inset:0;background:rgba(21,59,93,.42);display:flex;align-items:flex-end}.sheet{background:#fff;width:100%;border-radius:40rpx 40rpx 0 0;padding:42rpx;box-sizing:border-box}.sheet b{font-size:35rpx;color:#174d86}.sheet input,.clock{margin-top:26rpx;padding:20rpx;border-radius:18rpx;background:#edf8ff}.sheet button{margin-top:22rpx;background:#1685e4;color:#fff;border-radius:22rpx}

.page{background:#061238}.hero{background:linear-gradient(135deg,#354da9,#19216d);border:1rpx solid rgba(157,188,255,.35)}.preset-wrap>text{color:#dce8ff}.preset,.item{background:rgba(35,62,137,.72);border:1rpx solid rgba(155,188,255,.27);box-shadow:inset 0 1rpx rgba(255,255,255,.1),0 8rpx 18rpx rgba(0,0,28,.3)}.preset b,.title{color:#f2f7ff}.preset small,.more,.empty,.empty text{color:#aebfe6}.time{color:#ffd365}.check{border-color:#8eb6ff;background:#677be3}.add,.sheet button{background:linear-gradient(145deg,#83b8ff,#5368dc)}.mask{background:rgba(0,4,24,.68)}.sheet{background:#142760;border:1rpx solid rgba(155,188,255,.3)}.sheet b{color:#fff}.sheet input,.clock{background:rgba(72,105,187,.35);color:#fff}
