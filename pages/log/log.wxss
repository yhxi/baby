.page {
  min-height: 100vh;
  padding: 30rpx;
}

.section-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-subtitle {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-bottom: 24rpx;
}

.empty {
  text-align: center;
  padding: 50rpx 0;
}

.empty-emoji {
  font-size: 70rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-top: 16rpx;
}

.log-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.log-item:last-child {
  border-bottom: none;
}

.log-icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 22rpx;
}

.log-main {
  flex: 1;
}

.log-title {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.fever {
  font-size: 22rpx;
  color: #F44336;
  margin-left: 12rpx;
  background: #FFEBEE;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.log-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.log-date {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.arrow {
  color: var(--text-tertiary);
  margin-left: 8rpx;
}

.fab {
  position: fixed;
  right: 44rpx;
  bottom: 60rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF7B7B 0%, #FF9EB5 100%);
  color: #fff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(255, 123, 123, 0.45);
  z-index: 50;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 36rpx 50rpx;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.form-row.col {
  flex-direction: column;
  align-items: stretch;
}

.form-label {
  width: 160rpx;
  font-size: 30rpx;
  color: var(--text-primary);
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
}

.form-textarea {
  width: 100%;
  height: 110rpx;
  font-size: 28rpx;
  margin-top: 10rpx;
}

.seg {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 14rpx;
  background: var(--surface-2);
  color: var(--text-secondary);
  font-size: 26rpx;
}

.seg-item.active {
  background: #FF9800;
  color: #fff;
}

.btn-save {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #FF7B7B 0%, #FF9EB5 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
}

.btn-cancel {
  margin-top: 16rpx;
  background: var(--surface-2);
  color: var(--text-tertiary);
  font-size: 28rpx;
  border-radius: 50rpx;
  border: none;
}

button::after {
  border: none;
}
