.page {
  min-height: 100vh;
  padding: 24rpx 30rpx;
}

.empty {
  text-align: center;
  padding: 160rpx 0;
}

.empty-emoji {
  font-size: 100rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-tertiary);
  margin-top: 20rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 10rpx;
}

.day-group {
  margin-bottom: 36rpx;
}

.day-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.day-date {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.day-week {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-left: 14rpx;
}

.timeline {
  position: relative;
  padding-left: 150rpx;
}

.tl-item {
  position: relative;
  margin-bottom: 20rpx;
}

.tl-time {
  position: absolute;
  left: -150rpx;
  top: 26rpx;
  width: 120rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.tl-dot {
  position: absolute;
  left: -22rpx;
  top: 34rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx var(--border);
}

.tl-card {
  background: var(--card);
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tl-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
}

.tl-body {
  flex: 1;
}

.tl-type {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.tl-desc {
  font-size: 25rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
