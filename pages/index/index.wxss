.page{min-height:100vh;background:#dff4ff;color:#123c7a;overflow:hidden}.home-nav{position:relative;z-index:4;box-sizing:border-box;background:linear-gradient(135deg,#e9f8ff,#c5ebff);display:flex;align-items:center;justify-content:space-between;padding-left:28rpx;padding-right:190rpx;border-bottom:2rpx solid rgba(86,174,236,.18)}.nav-brand{display:flex;align-items:center;gap:13rpx;min-width:0}.nav-bear{width:56rpx;height:56rpx;border-radius:20rpx;background:linear-gradient(145deg,#43b9ff,#0875dc);color:#fff;display:flex;align-items:center;justify-content:center;font-size:18rpx;box-shadow:0 6rpx 14rpx rgba(18,116,211,.28)}.nav-brand text{display:block;font-size:29rpx;font-weight:900;color:#126dcc;line-height:1.1}.nav-brand small{display:block;margin-top:3rpx;font-size:17rpx;color:#669ac4;white-space:nowrap}.nav-chip{position:absolute;right:28rpx;bottom:15rpx;border-radius:28rpx;background:rgba(255,255,255,.85);color:#287bc4;padding:9rpx 14rpx;font-size:18rpx;font-weight:700;box-shadow:0 4rpx 12rpx rgba(37,125,195,.12)}
