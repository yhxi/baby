.page{min-height:100vh;background:#eaf7ff;color:#164b85}.home-nav{box-sizing:border-box;min-height:110rpx;display:flex;align-items:center;justify-content:space-between;padding:0 26rpx;background:linear-gradient(135deg,#e8f8ff,#c5edff);border-bottom:2rpx solid #bce6fb}.nav-brand{display:flex;align-items:center}.nav-bear{overflow:hidden;width:64rpx;height:64rpx;line-height:64rpx;text-align:center;border-radius:22rpx;background:#1685e4;color:#fff;font-size:18rpx;box-shadow:0 6rpx 12rpx rgba(21,120,210,.28)}.nav-bear image{width:100%;height:100%;display:block}.nav-brand view:last-child{margin-left:12rpx}.nav-brand text{display:block;color:#116dca;font-size:30rpx;font-weight:900}.nav-brand small{display:block;color:#6a9fc8;font-size:17rpx;margin-top:3rpx}.nav-chip{padding:9rpx 13rpx;background:#fff;border-radius:24rpx;color:#287dc5;font-size:18rpx}.workspace{height:calc(100vh - 130rpx);box-sizing:border-box;padding:24rpx 28rpx 170rpx}.now-card{position:relative;overflow:hidden;padding:32rpx 30rpx;border-radius:36rpx;background:linear-gradient(135deg,#42b8ff,#147dde);color:#fff;box-shadow:0 12rpx 25rpx rgba(17,111,199,.25)}.now-card:after{content:'';position:absolute;right:-54rpx;bottom:-85rpx;width:220rpx;height:220rpx;border:22rpx solid rgba(255,255,255,.11);border-radius:50%}.now-kicker{font-size:19rpx;letter-spacing:2rpx;opacity:.8}.now-main{position:relative;z-index:1;font-size:38rpx;font-weight:900;margin-top:12rpx}.now-sub{position:relative;z-index:1;font-size:20rpx;margin-top:10rpx;opacity:.9}.now-orbit{position:absolute;right:36rpx;top:32rpx;font-size:48rpx;color:#ffe348}.core-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin-top:20rpx}.core-action{min-height:142rpx;border-radius:25rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#175a99}.core-icon{width:58rpx;height:58rpx;line-height:58rpx;text-align:center;border-radius:50%;background:rgba(255,255,255,.78);font-size:32rpx}.core-action b{font-size:24rpx;margin-top:7rpx}.core-action small{font-size:16rpx;color:#6a98b9;margin-top:3rpx}.today-card,.timeline-card{margin-top:22rpx;padding:26rpx 24rpx;border-radius:32rpx;background:#fff;box-shadow:0 8rpx 19rpx rgba(31,120,185,.1)}.today-head{display:flex;align-items:center;justify-content:space-between}.today-kicker{display:block;font-size:17rpx;letter-spacing:3rpx;color:#70a8d1}.today-head b{display:block;font-size:33rpx;color:#174d8d}.today-head>text{color:#7aa5c5;font-size:19rpx}.today-stats{display:flex;margin-top:22rpx}.today-stats view{flex:1;text-align:center;border-right:2rpx solid #e2f1fb}.today-stats view:last-child{border:0}.today-stats b{display:block;font-size:28rpx;color:#177bd8}.today-stats text{display:block;margin-top:5rpx;color:#7b9ebb;font-size:17rpx}.card-title{display:flex;align-items:center;gap:8rpx}.card-title b{font-size:31rpx;color:#174d8d}.more{margin-left:auto;color:#2187dc;font-size:19rpx}.task-list{margin-top:13rpx}.task-item{display:flex;align-items:center;min-height:74rpx;border-bottom:2rpx dashed #dcecf8}.task-item:last-child{border:0}.task-time{width:70rpx;color:#1680db;font-size:21rpx;font-weight:bold}.task-dot{width:14rpx;height:14rpx;border-radius:50%;margin-right:12rpx}.task-copy{flex:1;min-width:0}.task-copy b{display:block;font-size:23rpx;color:#174f8d}.task-copy text{display:block;color:#7d9fbd;font-size:17rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.task-arrow{font-size:30rpx;color:#a0c3dc}.empty-task{text-align:center;padding:45rpx 0;color:#5f94bc}.empty-task small{display:block;margin-top:8rpx;color:#91b4cc}.tool-row{display:flex;gap:12rpx;margin-top:22rpx}.tool-row view{flex:1;padding:21rpx 6rpx;background:#fff;border-radius:22rpx;color:#397eb6;text-align:center;font-size:20rpx;box-shadow:0 6rpx 15rpx rgba(31,120,185,.08)}.bottom-space{height:20rpx}.dark.page{background:#071d3d}.dark .today-card,.dark .timeline-card,.dark .tool-row view{background:#102d57}.dark .today-head b,.dark .card-title b,.dark .task-cop