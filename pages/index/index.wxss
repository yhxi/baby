ow:0 8rpx 0 rgba(111,67,48,.10)}.hero-caption{font-size:25rpx;opacity:.86;position:relative;z-index:2}.hero-age{font-size:53rpx;font-weight:800;margin-top:8rpx;letter-spacing:-1rpx;position:relative;z-index:2}.hero-age text{color:#ffd552;font-size:43rpx}.sparkle{position:absolute;color:#fce778;font-size:32rpx}.s1{top:31rpx;right:158rpx}.s2{top:150rpx;right:42rpx;color:#fff}.growth-stats{display:flex;gap:14rpx;margin-top:36rpx;position:relative;z-index:2}.stat{flex:1;min-width:0;padding:14rpx 12rpx;background:rgba(255,255,255,.18);border:1rpx solid rgba(255,255,255,.18);border-radius:22rpx}.stat text{display:block;font-size:20rpx;opacity:.8}.stat b{font-size:34rpx;line-height:1.2}.stat small{font-size:17rpx;margin-left:3rpx;opacity:.85}.section-card{margin-top:26rpx;border-radius:38rpx;background:rgba(255,255,255,.92);padding:28rpx 24rpx;box-shadow:0 10rpx 25rpx rgba(193,118,150,.10)}.section-heading{display:flex;align-items:center;gap:10rpx;font-size:35rpx;font-weight:800;color:#4d4351}.heading-sun{color:#ffc92c;font-size:42rpx}.heading-note{margin-left:auto;color:#b09fab;font-weight:400;font-size:20rpx}.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14rpx 10rpx;margin-top:25rpx}.feature{min-height:116rpx;border-radius:22rpx;display:flex;flex-direction:column;justify-content:center;align-items:center;font-size:22rpx;font-weight:700;color:#5d5260}.feature-icon{width:58rpx;height:58rpx;border-radius:50%;background:rgba(255,255,255,.68);display:flex;justify-content:center;align-items:center;font-size:33rpx;margin-bottom:5rpx}.status-row{display:flex;gap:18rpx;margin-top:25rpx}.mini-status{flex:1;min-width:0;padding:22rpx;border-radius:27rpx;background:#fff4e9}.mini-status.blue{background:#ecf1ff}.mini-label{font-size:20rpx;color:#997f73}.blue .mini-label{color:#7181ad}.mini-main{margin-top:7rpx;color:#4e424d;font-size:28rpx;font-weight:800;white-space:nowrap}.mini-sub{margin-top:5rpx;display:block;color:#d27589;font-size:18rpx;overflow:hidden;text-ov