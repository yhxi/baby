.page { min-height: 100vh; background: #eaf7ff; color: #174b86; }
.paper-dots { position: fixed; inset: 0; background-image: radial-gradient(#c7eaff 2rpx, transparent 3rpx); background-size: 30rpx 30rpx; opacity: .6; pointer-events: none; }
.home-nav { position: relative; z-index: 10; box-sizing: border-box; min-height: 110rpx; display: flex; align-items: center; padding-left: 26rpx; padding-right: 190rpx; background: #d9f2ff; border-bottom: 2rpx solid #b9e3fb; }
.nav-brand { display: flex; align-items: center; }
.nav-bear { overflow: hidden; width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; border-radius: 22rpx; background: #1685e4; color: #fff; font-size: 17rpx; box-shadow: 0 6rpx 12rpx rgba(21, 120, 210, .28); }
.nav-bear image { width: 100%; height: 100%; display: block; }
.nav-brand view:last-child { margin-left: 12rpx; }
.nav-brand text { display: block; color: #116dca; font-size: 30rpx; font-weight: bold; }
.nav-brand small { display: block; margin-top: 3rpx; color: #6a9fc8; font-size: 17rpx; white-space: nowrap; }
.nav-chip { position: absolute; right: 24rpx; bottom: 16rpx; padding: 9rpx 15rpx; border-radius: 28rpx; background: #fff; color: #287dc5; font-size: 18rpx; }
.layout { position: relative; z-index: 1; display: block; height: calc(100vh - 130rpx); }
.side-rail { display: none; }
.rail-item { display: block; margin: 18rpx 8rpx; text-align: center; color: #4c8fc5; font-size: 18rpx; font-weight: bold; }
.rail-icon { width: 72rpx; height: 72rpx; line-height: 72rpx; margin: 0 auto 6rpx; border-radius: 24rpx; background: #fff; font-size: 36rpx; box-shadow: 0 4rpx 12rpx rgba(39,131,199,.12); }
.rail-active { color: #116fd0; }
.rail-active .rail-icon { background: #bfe9ff; }
.workspace { width: 100%; height: 100%; padding: 24rpx 28rpx 170rpx; box-sizing: border-box; }
.topline { display: flex; justify-content: space-between; align-items: center; margin: 0 4rpx 20rpx; }
.kicker { color: #5c99cb; font-size: 18rpx; letter-spacing: 2rpx; }
.page-title { color: #1177d4; font-size: 48rpx; line-height: 1.15; font-weight: bold; }
.date-pill { padding: 10rpx 14rpx; background: #fff; border-radius: 28rpx; color: #5a91bd; font-size: 18rpx; }
.hero-card { position: relative; overflow: hidden; min-height: 315rpx; padding: 38rpx 26rpx 24rpx; box-sizing: border-box; border-radius: 40rpx; background: linear-gradient(135deg,#43baff,#137fdf); color: #fff; box-shadow: 0 12rpx 26rpx rgba(23,114,200,.28); }
.bear { position: absolute; top: 22rpx; right: 22rpx; width: 108rpx; height: 98rpx; line-height: 98rpx; text-align: center; border-radius: 48rpx; background: #187fd8; border: 7rpx solid #75c8ff; color: #fff; font-size: 27rpx; }
.hero-caption { font-size: 23rpx; opacity: .9; }
.hero-age { margin-top: 8rpx; font-size: 50rpx; line-height: 1.1; font-weight: bold; }.hero-age text,.sparkle { color: #ffe14a; }
.sparkle { position: absolute; font-size: 31rpx; }.s1 { top: 32rpx; right: 145rpx; }.s2 { right: 25rpx; bottom: 37rpx; }
.growth-stats { display: flex; margin-top: 36rpx; }.stat { flex: 1; min-width: 0; margin-right: 10rpx; padding: 13rpx 9rpx; border-radius: 18rpx; background: rgba(255,255,255,.2); }.stat:last-child { margin-right: 0; }.stat text { display: block; font-size: 18rpx; }.stat b { font-size: 30rpx; }.stat small { font-size: 15rpx; }
.section-card { margin-top: 22rpx; padding: 24rpx 20rpx; border-radius: 32rpx; background: #fff; box-shadow: 0 8rpx 19rpx rgba(31,120,185,.1); }.section-heading { display: flex; align-items: center; color: #174f91; font-size: 32rpx; font-weight: bold; }.heading-sun { color: #ffcd2e; font-size: 40rpx; }.heading-note { margin-left: auto; color: #7ca8cc; font-size: 18rpx; font-weight: normal; }
.feature-grid { display: flex; flex-wrap: wrap; margin-top: 18rpx; }.feature { width: 31%; margin-right: 3.5%; margin-bottom: 12rpx; min-height: 112rpx; border-radius: 22rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #175b9b; font-size: 21rpx; font-weight: bold; }.feature:nth-child(3n) { margin-right: 0; }.feature-icon { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; border-radius: 50%; background: rgba(255,255,255,.75); font-size: 31rpx; margin-bottom: 5rpx; }
.status-row { display: flex; margin-top: 20rpx; }.mini-status { flex: 1; min-width: 0; margin-right: 14rpx; padding: 20rpx; border-radius: 24rpx; background: #fff5d9; }.mini-status:last-child { margin-right: 0; }.mini-status.blue { background: #e2f3ff; }.mini-label { color: #8a794f; font-size: 18rpx; }.blue .mini-label { color: #4789bb; }.mini-main { margin-top: 7rpx; color: #174d86; font-size: 25rpx; font-weight: bold; white-space: nowrap; }.mini-sub { display: block; margin-top: 5rpx; color: #cc974c; font-size: 17rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.blue .mini-sub { color: #4e91bf; }
.task-list { margin-top: 12rpx; }.task-item { display: flex; align-items: center; min-height: 72rpx; border-bottom: 2rpx dashed #d9ecf8; }.task-time { width: 72rpx; color: #1680db; font-size: 21rpx; font-weight: bold; }.task-dot { width: 14rpx; height: 14rpx; margin-right: 12rpx; border-radius: 50%; }.task-copy { flex: 1; min-width: 0; }.task-copy b { display:block; color:#174f8d; font-size:23rpx; }.task-copy text { display:block; color:#7d9fbd; font-size:17rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }.task-arrow { color:#9cc2df; font-size:32rpx; }.empty-task { padding: 40rpx 0; text-align:center; color:#6b9bc1; }.empty-task text { display:block; margin-top:8rpx; font-size:18rpx; }
.fab { position: fixed; z-index: 20; right: 32rpx; bottom: 150rpx; width: 108rpx; height: 108rpx; border-radius: 36rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#fff; background:#1685e4; box-shadow:0 10rpx 20rpx rgba(16,111,203,.35); }.fab text { font-size:46rpx; line-height:40rpx; }.fab small { font-size:18rpx; }.bottom-space { height:30rpx; }
