.space-home{min-height:100vh;background:radial-gradient(circle at 86% 6%,#1f4d9b 0,transparent 15%),radial-gradient(circle at 20% 0,#173a92 0,transparent 21%),#030c2e;color:#fff}.space-nav{box-sizing:border-box;padding:0 32rpx;display:flex;align-items:center;justify-content:space-between;background:rgba(2,12,44,.76);position:relative;z-index:4}.space-nav>text{font-size:31rpx;font-weight:900;letter-spacing:2rpx}.nav-avatar{width:58rpx;height:58rpx;line-height:58rpx;text-align:center;overflow:hidden;border-radius:50%;background:linear-gradient(145deg,#86b9ff,#5365dc);border:2rpx solid rgba(255,255,255,.5);box-shadow:0 0 17rpx rgba(117,164,255,.7)}.nav-avatar image{width:100%;height:100%;display:block}.space-scroll{height:calc(100vh - 120rpx);box-sizing:border-box;padding:0 22rpx 170rpx}.star-field{height:98rpx;position:relative;overflow:hidden}.planet{position:absolute}.p1{left:18rpx;top:9rpx;font-size:70rpx}.p2{right:45rpx;top:8rpx;font-size:56rpx;color:#547bd7;text-shadow:0 0 18rpx #8bb8ff}.shoot{position:absolute;left:295rpx;top:18rpx;transform:rotate(-20deg);font-size:47rpx;color:#c7e8ff}.twinkle{position:absolute;color:#ffd976;text-shadow:0 0 16rpx #ffd976}.t1{left:210rpx;top:13rpx;font-size:36rpx}.t2{right:120rpx;top:26rpx;font-size:26rpx}.hero-zone{height:340rpx;position:relative}.profile-pod{position:absolute;z-index:2;left:18rpx;top:28rpx;width:316rpx;min-height:248rpx;padding:25rpx 27rpx;box-sizing:border-box;border-radius:38rpx;background:linear-gradient(145deg,rgba(62,92,186,.92),rgba(30,48,122,.88));border:2rpx solid rgba(135,168,255,.63);box-shadow:inset 0 1rpx rgba(255,255,255,.2),0 16rpx 32rpx rgba(0,0,27,.5)}.pod-name{font-size:38rpx;font-weight:900}.pod-age{margin-top:10rpx;font-size:48rpx;font-weight:900}.pod-line{margin:18rpx 0;border-top:2rpx dashed rgba(177,202,255,.28)}.pod-metrics{display:flex}.pod-metrics view{flex:1}.pod-metrics text{display:block;color:#c9dcff;font-size:19rpx}.pod-metrics b{display:block;margin-top:8rpx;font-size:34rpx}.pod-