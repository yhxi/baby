<view class="page {{appDark ? 'dark' : ''}}">
  <view class="home-nav" style="padding-top:{{statusBarHeight}}px; height:{{navHeight}}px;">
    <view class="nav-brand"><view class="nav-bear" bindtap="onAvatarTap"><image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill"/><text wx:else>ʕ•ᴥ•ʔ</text></view><view><text>{{babyName}}</text><small>{{ageText || '新生儿照护中'}} · 点头像换照片</small></view></view>
    <view class="nav-chip">{{calendarText}}</view>
  </view>
  <scroll-view class="workspace newborn-workspace" scroll-y>
    <view class="now-card">
      <view class="now-kicker">此刻的照护状态</view><view class="now-main">{{nextActionText}}</view>
      <view class="now-sub">{{sleepStartedAt ? '再次点击“睡眠”结束计时' : '按宝宝的信号回应，不必机械追赶时间表'}}</view>
      <view class="now-orbit">✦</view>
    </view>
    <view class="core-grid">
      <view wx:for="{{coreActions}}" wx:key="key" class="core-action" style="background:{{item.tint}}" data-key="{{item.key}}" bindtap="onCoreAction"><view class="core-icon">{{item.key === 'sleep' && sleepStartedAt ? '⏱️' : item.icon}}</view><b>{{item.key === 'sleep' && sleepStartedAt ? '结束睡眠' : item.label}}</b><small>{{item.key === 'sleep' && sleepStartedAt ? '正在计时' : item.hint}}</small></view>
    </view>
    <view class="today-card">
      <view class="today-head"><view><text class="today-kicker">TODAY</text><b>今天的照护</b></view><text>{{todayRecords.length}} 条记录</text></view>
      <view class="today-stats"><view><b>{{todayFeedCount}}</b><text>次喂养</text></view><view><b>{{todayFeedTotal || '--'}}</b><text>ml 奶量</text></view><view><b>{{todayDiaperCount}}</b><text>次尿布</text></view><view><b>{{todaySleepText}}</b><text>睡眠</text></view></view>
    </view>
    <view class="timeline-card">
      <view class="card-title"><text>🗓️</text><b>今天的时光</b><text class="more" bindtap="onAddTap">添加记录 +</text></view>
      <view wx:if="{{todayTasks.length}}" class="task-list"><view wx:for="{{todayTasks}}" wx:key="id" class="task-item" data-id="{{item.id}}" bindtap="onRecordTap"><text class="task-time">{{item.timeText}}</text><view class="task-dot" style="background:{{item.color}}"></view><view class="task-copy"><b>{{item.typeLabel}}</b><text>{{item.desc}}</text></view><text class="task-arrow">›</text></view></view>
      <view wx:else class="empty-task"><text>今天还没有记录</text><small>从喂奶、睡眠或尿布开始</small></view>
    </view>
    <view class="tool-row"><view bindtap="onFeatureTap" data-url="/pages/album/album">📷 成长相册</view><view bindtap="onFeatureTap" data-url="/pages/planner/planner">✅ 今日待办</view><view bindtap="onFeatureTap" data-url="/pages/hub/hub">🧰 全部工具</view></view>
    <view class="bottom-space"></view>
  </scroll-view>
</view>
