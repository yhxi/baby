<view class="page space-home {{appDark ? 'dark' : ''}}">
  <view class="space-nav" style="padding-top:{{statusBarHeight}}px; height:{{navHeight}}px;"><text>✦ 宝宝星球</text><view class="nav-avatar" bindtap="onAvatarTap"><image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill"/><text wx:else>👶</text></view></view>
  <scroll-view class="space-scroll" scroll-y>
    <view class="star-field"><text class="planet p1">🪐</text><text class="shoot">☄</text><text class="planet p2">●</text><text class="twinkle t1">✦</text><text class="twinkle t2">✦</text></view>
    <view class="hero-zone">
      <view class="profile-pod"><text class="pod-name">{{babyName}}</text><view class="pod-age">{{ageText || '今天出生'}}</view><view class="pod-line"></view><view class="pod-metrics"><view><text>↕ 身高</text><b>{{latestHeight}}<small> cm</small></b></view><view><text>⚖ 体重</text><b>{{latestWeight}}<small> kg</small></b></view></view><text class="pod-recent">最近记录：{{lastFeed ? lastFeed.timeText : '暂无'}}</text><text class="pod-star">★</text></view>
      <image class="space-baby" src="/assets/space-baby-hero-lite.png" mode="aspectFit"/>
    </view>

    <view class="space-panel action-panel"><view wx:for="{{spaceActions}}" wx:key="key" class="space-action" data-item="{{item}}" bindtap="onSpaceAction"><view class="action-orb {{item.tone}}"><text>{{item.icon}}</text></view><text>{{item.label}}</text></view></view>

    <view class="space-panel records-panel"><view class="panel-title"><text>⭐</text><b>今日记录</b><small>🪐</small><text class="add-record" bindtap="onAddTap">＋</text></view><view wx:if="{{todayTasks.length}}" class="space-timeline"><view wx:for="{{todayTasks}}" wx:key="id" class="space-record" data-id="{{item.id}}" bindtap="onRecordTap"><view class="line-dot" style="background:{{item.color}}"></view><view class="record-orb" style="background:{{item.color}}">{{item.icon}}</view><view class="record-copy"><b style="color:{{item.color}}">{{item.timeText}}</b><text>{{item.typeLabel}} · {{item.desc}}</text></view><text class="record-star">★</text></view></view><view wx:else class="space-empty"><text>星球日志还是空的</text><small>点上方入口，记录宝宝的第一个小瞬间</small></view></view>

    <view class="space-panel album-panel" bindtap="onFeatureTap" data-url="/pages/album/album"><view class="panel-title"><text>📷</text><b>成长相册</b><text class="album-more">›</text></view><view wx:if="{{latestPhotos.length}}" class="album-grid"><image wx:for="{{latestPhotos}}" wx:key="id" src="{{item.localPath || item.path}}" mode="aspectFill"/></view><view wx:else class="album-empty"><text>📷</text><small>上传宝宝照片，保存每一次成长</small></view></view>
    <view class="space-bottom"></view>
  </scroll-view>
</view>
