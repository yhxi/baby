<view class="page space-home {{appDark ? 'dark' : ''}}">
  <view class="space-nav" style="padding-top:{{statusBarHeight}}px;height:{{navHeight}}px;"><text>✦ 宝宝星球</text><view class="nav-avatar" bindtap="onAvatarTap"><image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill"/><text wx:else>👶</text></view></view>
  <scroll-view class="space-scroll" scroll-y>
    <view class="star-field"><text class="planet p1">🪐</text><text class="shoot">☄</text><text class="planet p2">●</text><text class="twinkle t1">✦</text><text class="twinkle t2">✦</text></view>
    <view class="hero-zone"><view class="profile-pod"><text class="pod-name">{{babyName}}</text><view class="pod-age">{{ageText || '今天出生'}}</view><view class="pod-line"></view><view class="pod-metrics"><view><text>↕ 身高</text><b>{{latestHeight}}<small> cm</small></b></view><view><text>⚖ 体重</text><b>{{latestWeight}}<small> kg</small></b></view></view><text class="pod-recent">最近记录：{{lastFeed ? lastFeed.timeText : '暂无'}}</text><text class="pod-star">★</text></view><image class="space-baby" src="/assets/space-baby-hero-lite.png" mode="aspectFit"/></view>
    <view class="space-panel action-panel"><view wx:for="{{spaceActions}}" wx:key="key" class="space-action" data-item="{{item}}" bindtap="onSpaceAction"><view class="action-orb {{item.tone}}"><text>{{item.icon}}</text></view><text>{{item.label}}</text></view></view>
    <view class="space-panel records-panel"><view class="panel-title"><text>⭐</text><b>今日记录</b><small>🪐</small><text class="add-record" bindtap="onAddTap">＋</text></view><view wx:if="{{todayTasks.length}}" class="space-timeline"><view wx:for="{{todayTasks}}" wx:key="id" class="space-record" data-id="{{item.id}}" bindtap="onRecordTap"><view class="line-dot" style="background:{{item.color}}"></view><view class="record-orb" style="background:{{item.color}}">{{item.icon}}</view><view class="record-copy"><b style="color:{{item.color}}">{{item.timeText}}</b><text>{{item.typeLabel}} · {{item.desc}}</text></view><view style="position:absolute;right:20rpx;top:7rpx;width:72rpx;height:72rpx;line-height:72rpx;text-align:center;border-radius:23rpx;background:rgba(127,157,239,.24);font-size:45rpx;">{{item.art}}</view></view></view><view wx:else class="space-empty"><text>星球日志还是空的</text><small>点上方入口，记录宝宝的第一个小瞬间</small></view></view>
    <view class="space-panel album-panel" bindtap="onFeatureTap" data-url="/pages/album/album"><view class="panel-title"><text>📷</text><b>成长相册</b><text class="album-more">›</text></view><view wx:if="{{latestPhotos.length}}" class="album-grid"><image wx:for="{{latestPhotos}}" wx:key="id" src="{{item.localPath || item.path}}" mode="aspectFill"/></view><view wx:else class="album-empty"><text>📷</text><small>上传宝宝照片，保存每一次成长</small></view></view><view class="space-bottom"></view>
  </scroll-view>
  <view wx:if="{{showSleepSheet}}" bindtap="closeSleepSheet" style="position:fixed;z-index:20;inset:0;background:rgba(0,4,28,.68);display:flex;align-items:flex-end;"><view catchtap="" style="width:100%;box-sizing:border-box;padding:38rpx 30rpx calc(36rpx + env(safe-area-inset-bottom));border-radius:42rpx 42rpx 0 0;background:linear-gradient(145deg,#273f99,#132260);border:1rpx solid rgba(167,196,255,.45);color:#fff;"><view style="font-size:39rpx;font-weight:900;text-align:center;">🌙 睡眠记录</view><view wx:if="{{sleepActive}}" style="margin-top:24rpx;padding:22rpx;border-radius:24rpx;background:rgba(117,145,230,.22);"><b style="display:block;font-size:29rpx;">正在睡眠中</b><text style="display:block;margin-top:7rpx;color:#c5d7ff;font-size:21rpx;">宝宝醒来时点下方按钮，系统会自动计算时长</text><button bindtap="finishSleep" style="margin-top:18rpx;background:linear-gradient(145deg,#8abaff,#566be1);color:#fff;border-radius:24rpx;font-size:28rpx;">宝宝醒了，结束睡眠</button></view><view wx:else style="margin-top:24rpx;padding:22rpx;border-radius:24rpx;background:rgba(117,145,230,.22);"><b style="display:block;font-size:29rpx;">宝宝刚睡着？</b><text style="display:block;margin-top:7rpx;color:#c5d7ff;font-size:21rpx;">开始计时后，醒来时再回来结算。</text><button bindtap="beginSleep" style="margin-top:18rpx;background:linear-gradient(145deg,#8abaff,#566be1);color:#fff;border-radius:24rpx;font-size:28rpx;">现在开始计时</button></view><view style="margin:26rpx 0 8rpx;color:#ffd873;font-size:26rpx;font-weight:800;">或补录一段睡眠</view><view style="display:flex;align-items:center;gap:12rpx;padding:18rpx 0;border-bottom:1rpx solid rgba(175,201,255,.22);font-size:24rpx;"><text style="width:62rpx;color:#cbdcff;">开始</text><picker mode="date" value="{{sleepStartDate}}" bindchange="onSleepStartDate" style="flex:1;"><view style="padding:12rpx;border-radius:14rpx;background:rgba(104,137,219,.26);text-align:center;">{{sleepStartDate}}</view></picker><picker mode="time" value="{{sleepStartTime}}" bindchange="onSleepStartTime" style="flex:1;"><view style="padding:12rpx;border-radius:14rpx;background:rgba(104,137,219,.26);text-align:center;">{{sleepStartTime}}</view></picker></view><view style="display:flex;align-items:center;gap:12rpx;padding:18rpx 0;font-size:24rpx;"><text style="width:62rpx;color:#cbdcff;">结束</text><picker mode="date" value="{{sleepEndDate}}" bindchange="onSleepEndDate" style="flex:1;"><view style="padding:12rpx;border-radius:14rpx;background:rgba(104,137,219,.26);text-align:center;">{{sleepEndDate}}</view></picker><picker mode="time" value="{{sleepEndTime}}" bindchange="onSleepEndTime" style="flex:1;"><view style="padding:12rpx;border-radius:14rpx;background:rgba(104,137,219,.26);text-align:center;">{{sleepEndTime}}</view></picker></view><button bindtap="saveManualSleep" style="margin-top:18rpx;background:linear-gradient(145deg,#ffd86b,#df9b3a);color:#32230b;border-radius:24rpx;font-size:28rpx;">保存补录睡眠</button></view></view>
</view>
