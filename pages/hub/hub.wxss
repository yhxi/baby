.page{min-height:100vh;background:#fff8f5;padding-bottom:45rpx}.hero{padding:58rpx 38rpx 48rpx;background:linear-gradient(135deg,#ff91b2,#9876d7);color:#fff;border-radius:0 0 45rpx 45rpx}.hero text{display:block;font-size:18rpx;letter-spacing:4rpx;opacity:.8}.hero b{display:block;font-size:55rpx;margin:10rpx 0}.hero view{font-size:22rpx}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx;padding:28rpx}.tool{background:#fff;border-radius:27rpx;min-height:150rpx;padding:22rpx;box-sizing:border-box;box-shadow:0 8rpx 18rpx rgba(184,111,139,.11)}.tool text{font-size:43rpx;display:block}.tool b{display:block;color:#4f4150;font-size:27rpx;margin-top:10rpx}.tool small{display:block;color:#d082a1;font-size:19rpx;margin-top:6rpx}
