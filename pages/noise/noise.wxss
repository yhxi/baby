.page {
  padding: 24rpx 30rpx;
  box-sizing: border-box;
}

.noise-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.noise-item:last-child {
  border-bottom: none;
}

.noise-emoji {
  font-size: 56rpx;
  width: 90rpx;
  text-align: center;
}

.noise-main {
  flex: 1;
  margin-left: 16rpx;
}

.noise-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.noise-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.noise-btn {
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 26rpx;
  border-radius: 40rpx;
}
.noise-btn.on {
  background: var(--surface-2);
  color: var(--text-secondary);
}

.vol-row {
  display: flex;
  align-items: center;
}
.vol-label {
  font-size: 28rpx;
  color: var(--text-primary);
  width: 140rpx;
}
.vol-slider {
  flex: 1;
}
.vol-tip {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 16rpx;
  line-height: 1.5;
}
