<view class="page">
  <!-- 宝宝档案 -->
  <view class="section-title">宝宝档案</view>
  <view class="card">
    <view class="form-row">
      <text class="form-label">昵称</text>
      <input class="form-input" placeholder="如：小宝" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="form-row">
      <text class="form-label">出生日期</text>
      <picker mode="date" value="{{birthDate}}" bindchange="onDateChange">
        <view class="form-value">{{birthDate || '未设置'}} <text class="arrow">›</text></view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">性别</text>
      <view class="seg">
        <view class="seg-item {{gender === 'boy' ? 'active' : ''}}" data-value="boy" bindtap="onGenderChange">小王子</view>
        <view class="seg-item {{gender === 'girl' ? 'active' : ''}}" data-value="girl" bindtap="onGenderChange">小公主</view>
        <view class="seg-item {{gender === 'unknown' ? 'active' : ''}}" data-value="unknown" bindtap="onGenderChange">保密</view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label">当前年龄</text>
      <text class="form-static">{{ageText}}</text>
    </view>
    <button class="btn-save-flat" bindtap="onSaveProfile">保存档案</button>
  </view>

  <!-- 数据 -->
  <view class="section-title">我的数据</view>
  <view class="card">
    <view class="form-row">
      <text class="form-label">记录总数</text>
      <text class="form-static">{{recordCount}} 条</text>
    </view>
    <view class="menu-item" bindtap="onExport">
      <text>导出数据</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item danger" bindtap="onClear">
      <text>清空所有数据</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="about">
    <view class="about-logo">👶</view>
    <view class="about-name">宝宝养育计划</view>
    <view class="about-ver">v1.0 · 用心记录每一次成长</view>
  </view>
</view>
