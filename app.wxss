page {
  --primary: #FF7B7B;
  --primary-light: #FFF0F0;
  --secondary: #FFB347;
  --secondary-light: #FFF6E8;
  --sleep: #9BB5FF;
  --sleep-light: #F0F4FF;
  --diaper: #7EDDD6;
  --diaper-light: #E8FAF8;
  --pump: #FF9EB5;
  --pump-light: #FFF0F4;
  --medicine: #B8A1E6;
  --medicine-light: #F5F0FF;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --bg: #FFF8F5;
  --card: #FFFFFF;
  --border: #F0E6E2;
  background-color: var(--bg);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.container {
  padding: 24rpx 30rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 20rpx;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  align-items: center;
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
