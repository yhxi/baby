page {
  --primary: #167FDB;
  --primary-light: #E6F4FF;
  --secondary: #FFC836;
  --secondary-light: #FFF7DA;
  --sleep: #5A93F5;
  --sleep-light: #EAF1FF;
  --diaper: #51C9AA;
  --diaper-light: #E4FAF4;
  --pump: #5FB8F5;
  --pump-light: #E7F6FF;
  --medicine: #7D8EEA;
  --medicine-light: #EEF0FF;
  --text-primary: #164276;
  --text-secondary: #52789D;
  --text-tertiary: #88A7BF;
  --bg: #EAF7FF;
  --card: #FFFFFF;
  --border: #D6ECFB;
  --surface-2: #F3FAFF;
  background-color: var(--bg);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 页面根容器：深色模式在此切换变量 */
.page {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text-primary);
  box-sizing: border-box;
}

.page.dark {
  --primary: #5AB6FF;
  --primary-light: #112F55;
  --secondary: #FFD25F;
  --secondary-light: #3A311B;
  --sleep: #83B2FF;
  --sleep-light: #162D52;
  --diaper: #6ED7BD;
  --diaper-light: #123D39;
  --pump: #67C5FF;
  --pump-light: #123553;
  --medicine: #AAB6FF;
  --medicine-light: #202D5A;
  --text-primary: #ECECEC;
  --text-secondary: #B5B5B5;
  --text-tertiary: #8A8A8A;
  --bg: #071D3D;
  --card: #102D57;
  --border: #1F4B7C;
  --surface-2: #163862;
  background: var(--bg);
  color: var(--text-primary);
}

.container {
  padding: 24rpx 30rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 20rpx;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  align-items: center;
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 深空童趣主题：所有页面的共用星空底色与玻璃卡片 */
page { --primary:#7DB9FF; --primary-light:rgba(80,130,255,.20); --secondary:#FFD36D; --secondary-light:rgba(255,205,84,.16); --sleep:#AC8DFF; --sleep-light:rgba(153,118,255,.22); --diaper:#47DBBF; --diaper-light:rgba(48,205,176,.19); --pump:#66B7FF; --pump-light:rgba(75,163,255,.20); --medicine:#A18AFF; --medicine-light:rgba(157,129,255,.20); --text-primary:#F5F8FF; --text-secondary:#B9CAEC; --text-tertiary:#8199C3; --bg:#061238; --card:rgba(31,59,132,.68); --border:rgba(145,183,255,.34); --surface-2:rgba(92,125,210,.22); }
.page { background:radial-gradient(circle at 8% 6%,rgba(95,137,255,.3),transparent 25%),radial-gradient(circle at 92% 20%,rgba(93,64,190,.22),transparent 28%),#061238; }
.page.dark { --bg:#02081f; --card:rgba(20,40,95,.75); --border:rgba(145,183,255,.28); --surface-2:rgba(92,125,210,.18); background:var(--bg); }
.card { border:1rpx solid var(--border); border-radius:28rpx; box-shadow:inset 0 1rpx rgba(255,255,255,.12),0 14rpx 30rpx rgba(0,0,38,.26); }

/* 首页主视觉需要像太空绘本封面一样占据画面，而不是缩成角标。 */
.space-home .hero-zone { height: 400rpx !important; }
.space-home .space-baby { width: 730rpx !important; height: 410rpx !important; right: -42rpx !important; bottom: -12rpx !important; }
.space-home .profile-pod { top: 40rpx !important; width: 334rpx !important; min-height: 262rpx !important; }
.space-home .star-field { height: 112rpx !important; }
