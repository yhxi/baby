<view class="tab-shell"><view class="tab-inner"><view wx:for="{{list}}" wx:key="pagePath" class="tab {{selected === index ? 'selected' : ''}}" data-path="{{item.pagePath}}" bindtap="switchTab"><view class="tab-icon">{{item.icon}}</view><text>{{item.text}}</text><view wx:if="{{selected === index}}" class="active-dot"></view></view></view></view>
