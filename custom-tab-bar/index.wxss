.tab-shell { background: #f0f9ff; padding: 10rpx 18rpx 18rpx; box-sizing: border-box; }
.tab-inner { height: 98rpx; border-radius: 30rpx; background: #ffffff; display: flex; align-items: center; box-shadow: 0 6rpx 20rpx rgba(17,111,197,.14); border: 2rpx solid #d6efff; }
.tab { position: relative; flex: 1; height: 100%; text-align: center; color: #78a5ca; font-size: 18rpx; font-weight: 700; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: transform .12s ease, opacity .12s ease; }
.tab-icon { width: 42rpx; height: 42rpx; line-height: 42rpx; margin-bottom: 2rpx; border-radius: 14rpx; color: #6b9dc7; font-size: 27rpx; }
.selected { color: #1178d6; }
.selected .tab-icon { color: #ffffff; background: linear-gradient(145deg,#4abaff,#0874d8); box-shadow: 0 5rpx 12rpx rgba(11,107,203,.24); }
.active-dot { width: 7rpx; height: 7rpx; background: #ffce2f; border-radius: 50%; position: absolute; bottom: 8rpx; }
.tab-pressed { transform: scale(.91); opacity: .72; }

/* 深空底栏 */
.tab-shell{background:#061238}.tab-inner{background:rgba(25,47,112,.96);border:1rpx solid rgba(150,185,255,.32);box-shadow:inset 0 1rpx rgba(255,255,255,.14),0 -7rpx 25rpx rgba(0,0,0,.25)}.tab{color:#9db5dc}.tab-icon{box-sizing:border-box;line-height:38rpx;margin-bottom:4rpx;border-radius:50%;font-size:25rpx;color:#b6c8ec;background:rgba(140,170,235,.12);border:1rpx solid rgba(178,204,255,.16)}.selected{color:#fff4c8}.selected .tab-icon{background:linear-gradient(145deg,#719fff,#4a61d4);border-color:rgba(231,241,255,.55);box-shadow:0 4rpx 12rpx rgba(73,100,232,.42)}.active-dot{width:6rpx;height:6rpx;bottom:7rpx;background:#ffd465;box-shadow:0 0 9rpx #ffd465}.tab-pressed{transform:scale(.94);opacity:.78}
