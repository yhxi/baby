.tab-shell{background:transparent;padding:0 18rpx 18rpx;box-sizing:border-box}.tab-inner{height:108rpx;border-radius:38rpx;background:rgba(255,255,255,.96);display:flex;align-items:center;box-shadow:0 10rpx 30rpx rgba(17,111,197,.22);border:2rpx solid rgba(199,232,255,.9)}.tab{position:relative;flex:1;text-align:center;color:#75a2ca;font-size:19rpx;font-weight:700;display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%}.tab-icon{font-size:29rpx;line-height:31rpx}.selected{color:#1078d9}.selected .tab-icon{color:#fff;background:linear-gradient(145deg,#44b7ff,#0874d8);width:54rpx;height:54rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;margin-top:-29rpx;box-shadow:0 8rpx 18rpx rgba(11,107,203,.35)}.active-dot{width:8rpx;height:8rpx;background:#ffcf32;border-radius:50%;position:absolute;bottom:11rpx}
